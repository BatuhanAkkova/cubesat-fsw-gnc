BasedOnStyle: Google
IndentWidth: 4
ColumnLimit: 120
AllowShortFunctionsOnASingleLine: Empty
DerivePointerAlignment: false
PointerAlignment: Left
Standard: Latest
IncludeCategories:
  - Regex:           '^"fsw/.*'
    Priority:        2
  - Regex:           '^"common/.*'
    Priority:        3
  - Regex:           '^<Eigen/.*'
    Priority:        4
  - Regex:           '^<.*'
    Priority:        1
  - Regex:           '.*'
    Priority:        5
SortIncludes: true
SpaceBeforeRangeBasedForLoopColon: true
